<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" style="font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title></title>
    <style type="text/css">
      img {
        max-width: 100%;
        height: auto;
      }
      body {
        -webkit-font-smoothing: antialiased;
        -webkit-text-size-adjust: none;
        height: 100%;
        line-height: 1.5;
        width: 100% !important;
        background-color: #FFFFFF;
        margin: 0;
        padding: 0;
      }
      @media only screen and (max-width: 600px) {
        .container {
          width: 100% !important;
          padding: 0 !important;
        }
        .content {
          padding: 0 16px !important;
        }
      }
    </style>
  </head>

  <body itemscope itemtype="http://schema.org/EmailMessage" style="font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; width: 100% !important; height: 100%; line-height: 1.5; background-color: #FFFFFF; margin: 0; padding: 0;" bgcolor="#FFFFFF">
    <table class="body-wrap" style="width: 100%; background-color: #FFFFFF; margin: 0; padding: 48px 0 64px;" bgcolor="#FFFFFF">
      <tr style="margin: 0;">
        <td class="container" width="600" style="display: block !important; max-width: 600px !important; clear: both !important; margin: 0 auto;" valign="top">
          <div class="content" style="display: block; margin: 0 auto; padding: 0 24px;">
            <table class="main" width="100%" cellpadding="0" cellspacing="0" itemprop="action" itemscope itemtype="http://schema.org/ConfirmAction" style="background-color: #FFFFFF; text-align: left; margin: 0;" bgcolor="#FFFFFF">
              <tr style="margin: 0;">
                <td class="content-wrap" style="vertical-align: top; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;" valign="top">
                  <table width="100%" cellpadding="0" cellspacing="0" style="margin: 0;">
                    {{ content_for_layout }}
                  </table>
                </td>
              </tr>
            </table>

            <!-- Apple-style Divider -->
            <table width="100%" cellpadding="0" cellspacing="0" style="margin-top: 48px; border-top: 1px solid #D2D2D7;">
              <tr>
                <td style="padding-top: 24px; text-align: center; color: #86868B; font-size: 12px; line-height: 1.6; font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', sans-serif;">
                  <p style="margin: 0 0 4px 0; color: #6E6E73; font-weight: 500;">请您回到提问的网站查看并回复</p>
                  <p style="margin: 0; color: #86868B;">此邮件由支持团队自动发送，旨在为您提供及时的咨询更新。</p>
                </td>
              </tr>
            </table>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
