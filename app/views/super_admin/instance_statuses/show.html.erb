<% content_for(:title) do %>
  <%= t('super_admin.instance_statuses.title', default: '实例状态') %>
<% end %>
<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>
  </h1>
</header>
<%
  metric_translations = {
    'Chatwoot edition' => 'Chatwoot 版本',
    'Chatwoot version' => '系统版本号',
    'Git SHA' => 'Git 提交哈希 (SHA)',
    'Database Migrations' => '数据库迁移状态',
    'Postgres alive' => 'PostgreSQL 数据库连通状态',
    'Redis alive' => 'Redis 服务连通状态',
    'Redis version' => 'Redis 版本',
    'Redis number of connected clients' => 'Redis 当前连接客户端数',
    "Redis 'maxclients' setting" => "Redis 最大客户端限制 (maxclients)",
    'Redis memory used' => 'Redis 已用内存',
    'Redis memory peak' => 'Redis 内存峰值',
    'Redis total memory' => 'Redis 系统总内存'
  }
  value_translations = {
    'true' => '正常 (True)',
    'false' => '异常 (False)',
    'Enterprise' => '企业版 (Enterprise)',
    'Community' => '社区版 (Community)',
    'Custom' => '定制版 (Custom)',
    'completed' => '已全部完成 (Completed)',
    'pending' => '有待执行迁移 (Pending)'
  }
%>
<section class="main-content__body">
  <table>
  <tr>
    <th><%= t('super_admin.instance_statuses.metric', default: '指标名称') %></th>
    <th><%= t('super_admin.instance_statuses.value', default: '数值') %></th>
  </tr>
  <% @metrics.each do |key,value| %>
   <tr>
   <td> <%= metric_translations[key] || key %> </td>
   <td> <%= value_translations[value.to_s] || value %></td>
  </tr>
  <% end %>
</table>

</section>
