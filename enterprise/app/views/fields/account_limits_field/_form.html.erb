<%
  limit_names = {
    'agents' => '坐席客服数量限制',
    'inboxes' => '收件箱数量限制',
    'conversations' => '对话数量限制'
  }
%>
<div class="field-unit__label">
  <%= f.label field.attribute, t("helpers.label.account.limits", default: "配额限制") %>
</div>
<div class="field-unit__field">
  <% JSON.parse(field.to_s).each do |key,val| %>
    <div class="mb-2 flex items-center">
      <span class="inline-block w-44 text-sm text-slate-700"><%= t("super_admin.account_limits.#{key}", default: limit_names[key] || key.to_s.titleize) %>:</span>
      <%= number_field "account[limits]", key, value: val, class: "border border-slate-100 p-1 rounded-md" %>
    </div>
  <% end %>
</div>
