<% @messages.each do |message| %>
  <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; text-align: start; color: #334155; font-size: 14px; line-height: 1.6;">
    <% if message.content %>
      <%= ChatwootMarkdownRenderer.new(message.content).render_message %>
    <% end %>
    <% if message.attachments.present? %>
      <div style="margin-top: 10px; font-size: 13px; color: #64748B;">
        📎 附件：
        <% message.attachments.each_with_index do |attachment, index| %>
          <% if index > 0 %><span style="margin: 0 4px;">|</span><% end %>
          <a href="<%= attachment.file_url %>" target="_blank" style="color: #2563EB; text-decoration: none;"><%= attachment.file.filename.to_s %></a>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
