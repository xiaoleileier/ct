<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; box-sizing: border-box; font-size: 14px; margin: 0;">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title></title>
    <style type="text/css">
      img {
        max-width: 100%;
        height: auto;
      }
      body {
        -webkit-font-smoothing: antialiased;
        -webkit-text-size-adjust: none;
        height: 100%;
        line-height: 1.6;
        width: 100% !important;
        background-color: #F8FAFC;
        margin: 0;
        padding: 0;
      }
      @media only screen and (max-width: 600px) {
        .container {
          width: 100% !important;
          padding: 0 !important;
        }
        .content-wrap {
          padding: 24px 18px !important;
        }
      }
    </style>
  </head>

  <body itemscope itemtype="http://schema.org/EmailMessage" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; box-sizing: border-box; font-size: 14px; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: none; width: 100% !important; height: 100%; line-height: 1.6; background-color: #F8FAFC; margin: 0; padding: 0;" bgcolor="#F8FAFC">
    <table class="body-wrap" style="width: 100%; background-color: #F8FAFC; margin: 0; padding: 36px 0 60px;" bgcolor="#F8FAFC">
      <tr style="margin: 0;">
        <td class="container" width="600" style="display: block !important; max-width: 600px !important; clear: both !important; margin: 0 auto;" valign="top">
          <div class="content" style="display: block; margin: 0 auto; padding: 0 16px;">
            <!-- Brand / Top Header -->
            <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 16px;">
              <tr>
                <td style="padding: 0 4px;">
                  <span style="font-size: 14px; font-weight: 600; color: #0F172A; letter-spacing: -0.2px;">在线客服中心</span>
                </td>
                <td style="text-align: right; padding: 0 4px;">
                  <span style="display: inline-block; font-size: 11px; font-weight: 500; color: #64748B; background: #E2E8F0; padding: 3px 8px; border-radius: 12px;">新回复</span>
                </td>
              </tr>
            </table>

            <!-- Main White Card -->
            <table class="main" width="100%" cellpadding="0" cellspacing="0" itemprop="action" itemscope itemtype="http://schema.org/ConfirmAction" style="border-radius: 12px; background-color: #FFFFFF; text-align: left; margin: 0; border: 1px solid #E2E8F0; box-shadow: 0 4px 12px -2px rgba(15, 23, 42, 0.06), 0 2px 4px -1px rgba(15, 23, 42, 0.03);" bgcolor="#FFFFFF">
              <tr style="margin: 0;">
                <td class="content-wrap" style="vertical-align: top; margin: 0; padding: 32px 30px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;" valign="top">
                  <table width="100%" cellpadding="0" cellspacing="0" style="margin: 0;">
                    {{ content_for_layout }}
                  </table>
                </td>
              </tr>
            </table>
          </div>

          <!-- Footer -->
          <div class="footer" style="color: #94A3B8; margin: 0; padding: 24px 20px 0; text-align: center; font-size: 12px; line-height: 1.6;">
            <table width="100%" style="margin: 0;">
              <tr style="margin: 0;">
                <td class="content-block" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; vertical-align: top; margin: 0; padding: 0; color: #94A3B8;" valign="top">
                  请您回到提问的网站查看并回复
                </td>
              </tr>
            </table>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>
