<% content_for(:title) { t("administrate.actions.edit_resource", name: display_resource_name(page.resource_name), default: "编辑 #{display_resource_name(page.resource_name)}") } %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title">
    <%= content_for(:title) %>
  </h1>

  <div>
    <%= link_to(
      t("administrate.actions.show_resource", name: display_resource_name(page.resource_name), default: "查看 #{display_resource_name(page.resource_name)}"),
      [namespace, page.resource],
      class: "button",
    ) if accessible_action?(page.resource, :show) %>
    <%= link_to(
      t("administrate.actions.back", default: "返回"),
      [namespace, page.resource_path.to_sym],
      class: "button",
    ) %>
  </div>
</header>

<section class="main-content__body">
  <%= render "form", page: page %>
</section>
